<odoo>
  <data>
    <record id="contact_patient_id" model="ir.ui.view">
      <field name="name">Contact_Patient_id</field>
      <field name="model">res.partner</field>
      <field name="inherit_id" ref="base.view_partner_form"/>
      <field name="arch" type="xml">
        <xpath expr="//form//sheet" position="before">
          <header>
            <button name="my_hospital.add_appointment_action" 
            string="Add Appointment"
            type="action" class="btn-primary" 
            context="{'default_patient_id': active_id}"
            ></button>
          </header>
          
        </xpath>

      <xpath expr="//field[@name='vat']" position="after">
      <field name="is_patient"/>   
      <field name="birthday"/>
      <field name="age"/>
      </xpath>  

      <xpath expr="//div[@name='button_box']" position="inside">
        <button name="get_appointment" string="Appointments" 
        invisible="is_patient == False" type="object" icon="fa-calendar">
        <field name="app_count" string="Appointments" widget="statinfo"></field>

        </button>
      </xpath>

      </field>
      </record>

      <record id="my_hospital.patient_list_action" model="ir.actions.act_window">
        <field name="name">Patients</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">tree,form,kanban</field>
        <field name="domain">[('is_patient','=',True)]</field>
        <field name="help" type="html"><h1>No Patients, Add one ......</h1></field>
      </record>
      


      
  </data>
</odoo>
