<odoo>

    <record id="medicine_view_tree" model="ir.ui.view">
        <field name="name">Medicine.view.tree</field>
        <field name="model">medicines</field>
        <field name='arch' type='xml'>
                
                    <tree string="medicine_tree">
                        <field name="name"></field>
                        <field name="effective_material"></field>
                        
                    </tree>
             </field>
    </record>
      
    <record id="medicies_view_form" model="ir.ui.view">
        <field name="name">Medicines_view_form</field>
        <field name="model">medicines</field>
        <field name="arch" type="xml">
                    <form string="">
                        <sheet>
                            <group>
                                <group string="Medicine Name">
                                    <field name="name"></field>
                                    
                                </group>
                                <group string="Effective Material">
                                    <field name="effective_material"></field>
                                </group>
                            </group>
                        </sheet>
                    </form>
                </field>
            </record>
       


    <record id="my_hospital.medicines_action" model="ir.actions.act_window">
        <field name="name">Medicines_Action</field>
        <field name="res_model">medicines</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add new Medicine .....</p>
        </field>
    </record>

</odoo>
